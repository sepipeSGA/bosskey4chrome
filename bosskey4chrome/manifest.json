{
  "manifest_version": 3,
  "name": "BossKey 老板键",
  "version": "1.3.0",
  "description": "一键隐藏当前窗口所有标签页并显示伪装页，再按快捷键原样恢复。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "BossKey 老板键",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/service_worker.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "storage"
  ],
  "commands": {
    "bosskey-hide": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "隐藏当前窗口所有标签页并显示伪装页"
    },
    "bosskey-restore": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "恢复上次被隐藏的标签页"
    }
  }
}
